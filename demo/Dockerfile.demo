#
# Multi-stage Dockerfile for hoike demo
# Stage 1: Builder (includes build tools, OpenSSL for fixture generation)
# Stage 2: Runtime (minimal image with hoike + ahu binaries)

# ── Builder stage ──
FROM rust:1.82-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    openssl \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifests and build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates

# Build release binaries
RUN cargo build --release --bins

# ── Runtime stage ──
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries from builder
COPY --from=builder /build/target/release/hoike /usr/local/bin/hoike
COPY --from=builder /build/target/release/ahu /usr/local/bin/ahu

# Create demo workspace
RUN mkdir -p /demo/fixtures /demo/bundles /demo/configs /demo/scripts /demo/state-ecdsa /demo/state-mldsa

WORKDIR /demo

# Default command (overridden by docker-compose)
CMD ["/usr/local/bin/hoike", "--help"]
